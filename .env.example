# Capital Q environment template.
#
# Placeholders only -- never commit real values. Copy to .env.local for local
# development; .env.local is gitignored.
#
# Every variable here is validated by @capital-q/config. Provider variables
# (database, model providers, video, queues) are deliberately absent: each is
# added by the packet that introduces that provider, so this file never lists
# configuration the code does not actually read.
#
# How `pnpm dev` loads local configuration (two gitignored files):
#   .env.local            read by api, q-api and workers through
#                         scripts/dev-env.mjs, which their `dev` scripts
#                         preload. Server-only values live here.
#   apps/web/.env.local   read by Next.js itself for the web app. Only the
#                         NEXT_PUBLIC_* values and the CQ_* web settings
#                         belong there -- never a secret or database URL.
# Deployed processes receive configuration from the platform; neither file is
# read by `start`, by a build, or in any hosted environment.
#
# NODE_ENV is intentionally not listed. Node, Next.js and the test runner set it.

# Capital Q deployment class: local | preview | staging | production.
# Operational metadata only -- never an authorization or security boundary.
# Defaults to `local` when unset.
CAPITAL_Q_ENV=local

# Service networking. Hosting platforms normally inject PORT, so these are
# usually left unset locally. An absent PORT uses the service default
# (api 3001, q-api 3002); an invalid PORT fails startup rather than silently
# falling back.
# HOST=0.0.0.0
# PORT=3001

# Server-only PostgreSQL configuration, validated by @capital-q/config/database.
# DATABASE_URL is a secret: never NEXT_PUBLIC_, never logged, never in a prompt.
# The local Supabase stack listens on 54322; the value below is the CLI default
# and is not a credential for anything outside this machine.
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:54322/postgres

# direct | session_pooler | transaction_pooler. Transaction mode disables
# prepared statements automatically.
DATABASE_CONNECTION_MODE=direct
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Required only in preview/staging/production, and only by processes that
# actually create a privileged or migration client. Locally both fall back to
# DATABASE_URL because the local stack has no dedicated runtime roles.
# DATABASE_PRIVILEGED_URL=
# DATABASE_MIGRATION_URL=

# Outbox publisher runner (apps/workers). Bounded; defaults suit local/demo.
# The queue name is a code constant and is deliberately not configurable.
# OUTBOX_PUBLISH_BATCH_SIZE=25
# OUTBOX_POLL_INTERVAL_MS=750
# OUTBOX_MAX_ATTEMPTS=10

# Supabase Auth (CQ-AUTH-001). The project URL and the PUBLISHABLE (anon) key
# are public values. A secret or service-role key is refused by validation
# and must never be configured under any of these names.
#
# Web app (apps/web/.env.local for `next dev`; injected at runtime on Vercel):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<local publishable key from `supabase status`>
# The origin Capital Q is served from; used for email callback links. Defaults
# to http://127.0.0.1:3000 locally and is required in every other environment.
# CQ_WEB_ORIGIN=http://127.0.0.1:3000
# Base URL of the Capital Q API for server-side calls (GET /v1/me). Optional.
# CQ_API_URL=http://127.0.0.1:3001
# Base URL of the Q API, which is a separate deployable. Optional: without it
# the Home composer says Q is not connected on this build and sends nothing.
# CQ_Q_API_URL=http://127.0.0.1:3002
#
# Continue with Google against the LOCAL Supabase stack only (CQ-C5-R2A).
# Both are required before setting enabled = true in [auth.external.google];
# the client secret is a secret and never belongs in the browser or in Git.
# Hosted projects configure the provider in the Supabase dashboard instead.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
#
# api and q-api (required at startup; the services refuse to run without them):
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_<local publishable key from `supabase status`>
#
# Privileged storage authority for private document upload (api, CQ-EVD-002)
# and document processing (workers, CQ-EVD-003). SECRET: server-only, never
# NEXT_PUBLIC_, never in apps/web/.env.local, never logged. Optional: without
# it those document boundaries stay closed and the rest of each service runs.
# Validation refuses a publishable key here and a secret key in the public
# names above.
# SUPABASE_SECRET_KEY=sb_secret_<local secret key from `supabase status`>
#
# Document processing worker (CQ-EVD-003). REQUIRE_CLEAN is the only value a
# hosted environment accepts. ALLOW_UNSCANNED lets the local stack exercise
# the pipeline without a malware scanner; configuration refuses it unless
# CAPITAL_Q_ENV=local, and every run records that no scan happened.
# CQ_MALWARE_POLICY=REQUIRE_CLEAN

# Model providers (CQ-Q-005), read by q-api only. Each is optional: the Model
# Gateway routes around an unconfigured provider. Server-only secrets: never
# NEXT_PUBLIC_, never logged, never in a prompt, never in a database row or a
# test fixture. Possessing a key does not make a provider eligible for private
# customer data — eligibility is a reviewed ai_ops policy record.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Public-web research provider (CQ-Q-RESEARCH-001), read by q-api only.
# Optional: without it Q's public research tools are not composed. Server-only
# secret: never NEXT_PUBLIC_, never logged, never in a prompt, never in a
# database row or a test fixture. Only search and extract are used; the
# outbound query is composed from the person's own words and authorised public
# identity, never from private context.
# TAVILY_API_KEY=

# Realtime speech provider (CQ-Q-VOICE-001), read by q-api only. Optional:
# without the key and a Speech Engine id the voice routes are not registered.
# Server-only secret: never NEXT_PUBLIC_, never logged, never in a prompt.
# The Speech Engine ids are account resources created by `pnpm voice:setup`
# (one per voice, same WebSocket route); the tunnel hostname they point at is
# runtime configuration and is never committed.
# ELEVENLABS_API_KEY=
# ELEVENLABS_SPEECH_ENGINE_ID=
# ELEVENLABS_SPEECH_ENGINE_ID_MALE=

# Founder onboarding client for the web app: fixture | none. Unset means
# fixture outside production NODE_ENV and none in production builds. The
# fixture adapter is refused when CAPITAL_Q_ENV=production.
# CQ_FOUNDER_ONBOARDING_ADAPTER=fixture

# Local embedding runtime (CQ-RAG-002). NON-SECRET: there is no embedding
# credential of any kind. The configured model is open-weight and served by
# a runtime Capital Q operates, so confidential document text never leaves
# this infrastructure to be embedded. The endpoint must be loopback or a
# private-network host; a public address is refused at configuration time.
# Start it with `pnpm embedding:up`.
# Q_EMBEDDING_PROVIDER=local-tei
# Q_EMBEDDING_BASE_URL=http://127.0.0.1:8080
# Q_EMBEDDING_TIMEOUT_MS=60000
# Q_EMBEDDING_MAX_BATCH_ITEMS=16
# Host port for the local embedding container; set it when 8080 is taken.
# CQ_EMBEDDING_HOST_PORT=8080
