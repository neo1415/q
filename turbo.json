{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // The heap size a caller sets (ci-local exports 8 GB) must reach the
      // task; strict mode drops it, leaving Node's ~2 GB default.
      "passThroughEnv": ["NODE_OPTIONS"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      // Gate on fd1ad528c: apps/web's tsc needs ~2.5 GB and ran out of heap
      // at the ~2 GB default because strict mode dropped NODE_OPTIONS.
      "passThroughEnv": ["NODE_OPTIONS"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Turbo's strict mode hands a task only the variables turbo.json
      // declares. `pnpm demo --local` overrides the Supabase variables in
      // its own environment so the files can keep naming the hosted
      // project; strict mode silently dropped them and every service read
      // the file instead. Nothing here is cached, so passing the whole
      // environment through costs nothing.
      "envMode": "loose"
    },
    "clean": {
      "cache": false
    }
  }
}
