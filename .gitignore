# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Task cache
.turbo/

# Test / coverage output
coverage/
playwright-report/
blob-report/
test-results/
.playwright/

# Local environment.
# Secrets are never committed; example files carry names and placeholders only.
# See docs/architecture/23_Capital_Q_Engineering_Standards_Repository_Architecture.md (225-227).
.env
.env.*
!.env.example
!.env.*.example

# Next.js generated types
next-env.d.ts

# Agent instruction files regenerated by `next dev`
# (next/dist/server/lib/generate-agent-files.js). The canonical repository
# AGENTS.md lives at the root and is authored by CQ-FOUND-004, not generated
# per-app by a framework.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Coding-agent scratch space
.tmp/

# OS / editor
.DS_Store
Thumbs.db

# Per-developer in-app browser preview configuration.
.claude/launch.json

# Eval run reports (volatile; baselines are source-controlled under packages/q-evals/baselines)
artifacts/

# Embedding model weights and caches (CQ-RAG-002). Weights live in a Docker
# named volume, never in source control and never inside an application
# image; these entries catch a local bind mount by accident.
models/
.cache/huggingface/
*.safetensors
*.onnx
