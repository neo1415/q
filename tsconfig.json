{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "include": [
    // Railway deployment configuration (ADR 0014). Included so the authoring
    // file is typechecked and lintable like everything else, rather than being
    // an unchecked TypeScript file the Railway CLI evaluates.
    ".railway/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.live-model.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "apps/**/*.test.ts",
    "apps/**/*.spec.ts",
    "packages/**/*.test.ts",
    "packages/**/*.spec.ts",
    "packages/**/*.test.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    ".next",
    "**/.next",
    "apps/web"
  ]
}
