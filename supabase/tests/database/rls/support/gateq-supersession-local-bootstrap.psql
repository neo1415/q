\set ON_ERROR_STOP on
select current_database() = 'cq_gateq_supersession_test' as disposable \gset
\if :disposable
\else
  \echo 'Refusing: use the disposable cq_gateq_supersession_test database'
  \quit 1
\endif
-- DISPOSABLE LOCAL DATABASE ONLY: cq_gateq_supersession_test.
-- Thin ancestor tables supply synthetic identities/gateways. They do NOT
-- reproduce the platform RLS/authentication schema. The actual applications,
-- facts, transcript, exchange claims, index, CHECK/FK and correction migration
-- below come directly from immutable canonical migrations.
-- Protected full-Supabase pgTAP CI is still required before any release.
do $$ begin if not exists (select 1 from pg_roles where rolname = 'anon') then create role anon; end if; if not exists (select 1 from pg_roles where rolname = 'authenticated') then create role authenticated; end if; end $$;
create schema extensions; create schema identity; create schema core; create schema gateq;
create table identity.tenants(id uuid primary key);
create table core.investor_organisations(id uuid primary key, tenant_id uuid, organisation_id uuid, investor_type text, display_name text);
create table gateq.gateways(id uuid primary key, tenant_id uuid, investor_organisation_id uuid, organisation_id uuid, public_id text, name text, created_by_user_id uuid);
create table gateq.gateway_versions(id uuid primary key, gateway_id uuid, tenant_id uuid, version_number integer, status text, inbound_mode text, public_title text, qualification_policy_version text, created_by_user_id uuid, published_by_user_id uuid, published_at timestamptz);
\ir ../../../../migrations/20261002090000_gateq_applications.sql
\ir ../../../../migrations/20261223090000_gateq_interview_turns_contacts_dossier.sql
\ir ../../../../migrations/20261223100000_gateq_exchange_claims.sql
\ir ../../../../migrations/20261224100000_gateq_fact_supersession.sql
