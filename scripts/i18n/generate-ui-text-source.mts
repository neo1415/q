/**
 * Writes packages/q-core/src/ui-text/source.generated.ts: every English
 * interface and email string Capital Q translates (the keys of the web's
 * per-area catalogues and of the email catalogue), and, per hand-written
 * catalogue, the strings it lacks. Machine translation (UI_TRANSLATION)
 * works from this list only, so a client can never make Q translate (and
 * spend on) arbitrary text.
 *
 *   node --experimental-strip-types scripts/i18n/generate-ui-text-source.mts
 *
 * (Node 24 strips types without the flag.) A web test fails when the file
 * is stale.
 */
import { execFileSync } from "node:child_process";
import { readdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = join(dirname(fileURLToPath(import.meta.url)), "..", "..");
const catalogDir = join(root, "apps/web/src/features/i18n/catalog");

type Catalogue = Readonly<Record<string, string>>;
const isCatalogue = (value: unknown): value is Catalogue =>
  typeof value === "object" && value !== null && !Array.isArray(value);

/** Hand catalogues by primary subtag: the export's suffix (`CORE_AR` -> "ar"). */
const hand = new Map<string, Map<string, string>>();
const source = new Set<string>();

async function collect(file: string): Promise<void> {
  const module = (await import(file)) as Record<string, unknown>;
  for (const [name, value] of Object.entries(module)) {
    if (!isCatalogue(value)) continue;
    const suffix = /_([A-Z]{2,3})$/u.exec(name)?.[1]?.toLowerCase();
    if (suffix === undefined) continue;
    const catalogue = hand.get(suffix) ?? new Map<string, string>();
    for (const [english, translated] of Object.entries(value)) {
      if (typeof translated !== "string") continue;
      source.add(english);
      catalogue.set(english, translated);
    }
    hand.set(suffix, catalogue);
  }
}

for (const file of readdirSync(catalogDir).sort()) {
  if (file.endsWith(".ts")) await collect(join(catalogDir, file));
}
// The email catalogue exports EMAIL_ARABIC.
const email = (await import(join(root, "packages/email/src/arabic.ts"))) as Record<string, unknown>;
for (const value of Object.values(email)) {
  if (!isCatalogue(value)) continue;
  const catalogue = hand.get("ar") ?? new Map<string, string>();
  for (const [english, translated] of Object.entries(value)) {
    source.add(english);
    catalogue.set(english, translated);
  }
  hand.set("ar", catalogue);
}

const strings = [...source].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
const gaps = Object.fromEntries(
  [...hand.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([language, catalogue]) => [
      language,
      strings.filter((english) => !catalogue.has(english)),
    ]),
);

const out = `// GENERATED by scripts/i18n/generate-ui-text-source.mts -- do not edit.
// The English interface and email strings machine translation works from,
// and what each hand-written catalogue lacks (only those are machine-filled).

/** Every English source string, sorted. */
export const UI_TEXT_SOURCE: readonly string[] = ${JSON.stringify(strings, null, 1)};

/** Hand-written catalogues by primary subtag, and the source strings each lacks. */
export const UI_TEXT_HAND_GAPS: Readonly<Record<string, readonly string[]>> = ${JSON.stringify(gaps, null, 1)};
`;
const target = join(root, "packages/q-core/src/ui-text/source.generated.ts");
writeFileSync(target, out);
// Formatted like every other source file, so format:check stays green.
execFileSync(join(root, "node_modules/.bin/prettier"), ["--write", target], { stdio: "ignore" });
console.log(`${strings.length} strings; hand catalogues: ${Object.entries(gaps).map(([l, g]) => `${l} (${g.length} gaps)`).join(", ")}`);
