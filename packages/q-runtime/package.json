{
  "name": "@capital-q/q-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Q runtime bounded context: durable Q conversations, conversation messages, runs, append-only run events, the run lifecycle policy and the application services the Q API composes. Never orchestration, never a model, never the Context Firewall, never Q knowledge.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/audit": "workspace:*",
    "@capital-q/capital": "workspace:*",
    "@capital-q/companies": "workspace:*",
    "@capital-q/contracts": "workspace:*",
    "@capital-q/database": "workspace:*",
    "@capital-q/evidence": "workspace:*",
    "@capital-q/investors": "workspace:*",
    "@capital-q/network": "workspace:*",
    "@capital-q/observability": "workspace:*",
    "@capital-q/organisations": "workspace:*",
    "@capital-q/security": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capital-q/config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
