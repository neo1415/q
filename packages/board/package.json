{
  "name": "@capital-q/board",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The person's own work board: items (a document, a company, a task, a note, a piece of Q's work) in TODO, DOING and DONE, ordered, revisioned and with append-only history. Owns workspace.board_items and board_item_events; reads another context only through injected ports.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/contracts": "workspace:*",
    "@capital-q/database": "workspace:*",
    "@capital-q/security": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capital-q/config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
