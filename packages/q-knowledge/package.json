{
  "name": "@capital-q/q-knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Capital Q knowledge bounded context (CQ-RAG-001): structure-aware, versioned, provenance-preserving chunks derived from governed document extractions. Deterministic chunking strategies, chunk sets with lifecycle, inheritance of visibility and sensitivity, rebuild and revocation. No embedding, no vector index, no retrieval, no model call, no knowledge object.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./chunking": {
      "types": "./dist/chunking/index.d.ts",
      "default": "./dist/chunking/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/config": "workspace:*",
    "@capital-q/contracts": "workspace:*",
    "@capital-q/database": "workspace:*",
    "@capital-q/evidence": "workspace:*",
    "@capital-q/observability": "workspace:*",
    "@capital-q/q-core": "workspace:*",
    "@capital-q/q-embeddings": "workspace:*",
    "@capital-q/q-runtime": "workspace:*",
    "@capital-q/security": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
