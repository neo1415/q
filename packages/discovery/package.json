{
  "name": "@capital-q/discovery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Capital Q discovery (doc 19): who an investor or a founder could reasonably meet, chosen by declared eligibility and declared fit, ranked deterministically with versioned weights, and explained from the fields that produced it. No model runs here, nothing is ranked by popularity, and nothing private crosses the network.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/companies": "workspace:*",
    "@capital-q/contracts": "workspace:*",
    "@capital-q/database": "workspace:*",
    "@capital-q/investors": "workspace:*",
    "@capital-q/network": "workspace:*",
    "@capital-q/observability": "workspace:*",
    "@capital-q/permissions": "workspace:*",
    "@capital-q/q-embeddings": "workspace:*",
    "@capital-q/security": "workspace:*",
    "@capital-q/taxonomy": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capital-q/audit": "workspace:*",
    "@capital-q/capital": "workspace:*",
    "@capital-q/config": "workspace:*",
    "@capital-q/eventing": "workspace:*",
    "@capital-q/organisations": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
