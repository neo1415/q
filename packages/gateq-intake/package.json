{
  "name": "@capital-q/gateq-intake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GateQ intake: a stranger's application to a gateway, the guest session that carries it, what they told us and with what provenance, and the submission that is the disclosure boundary.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/audit": "workspace:*",
    "@capital-q/contracts": "workspace:*",
    "@capital-q/database": "workspace:*",
    "@capital-q/email": "workspace:*",
    "@capital-q/gateq": "workspace:*",
    "@capital-q/model-gateway": "workspace:*",
    "@capital-q/observability": "workspace:*",
    "@capital-q/q-core": "workspace:*",
    "@capital-q/security": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capital-q/config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
