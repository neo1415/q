{
  "name": "@capital-q/gateq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GateQ bounded context: an investor organisation's versioned, published inbound gateway policy and the deterministic engine that decides whether an application satisfies it.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/audit": "workspace:*",
    "@capital-q/contracts": "workspace:*",
    "@capital-q/database": "workspace:*",
    "@capital-q/observability": "workspace:*",
    "@capital-q/security": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capital-q/config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
