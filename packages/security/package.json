{
  "name": "@capital-q/security",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable security context, authorization and redaction primitives.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@capital-q/contracts": "workspace:*",
    "zod": "4.5.4"
  }
}
