{
  "name": "@capital-q/deck-render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Artifact rendering: one deterministic layout over a composed deck (SVG, PPTX, PDF) and a document layout for every other artifact type (PDF), set in a bundled Unicode font. Decides nothing about what an artifact says.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/contracts": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pdfjs-dist": "6.3.289",
    "typescript": "5.9.3"
  }
}
