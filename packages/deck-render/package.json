{
  "name": "@capital-q/deck-render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deck rendering: one deterministic layout over a composed deck, inspected for the faults a slide can have, and drawn as SVG, PPTX and PDF. Decides nothing about what a deck says.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/contracts": "workspace:*",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
