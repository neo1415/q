{
  "name": "@capital-q/taxonomy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Taxonomy platform capability: the canonical, versioned, multi-vocabulary, multi-label classification language shared by companies and investor mandates.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./reference-data": {
      "types": "./dist/reference-data/index.d.ts",
      "default": "./dist/reference-data/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "render:reference-sql": "node scripts/render-reference-sql.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capital-q/audit": "workspace:*",
    "@capital-q/companies": "workspace:*",
    "@capital-q/contracts": "workspace:*",
    "@capital-q/database": "workspace:*",
    "@capital-q/eventing": "workspace:*",
    "@capital-q/observability": "workspace:*",
    "@capital-q/security": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capital-q/config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  }
}
