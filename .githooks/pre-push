#!/usr/bin/env bash
# Refuse a push to the production branch without a local-gate PASS receipt
# for the exact commit (decision 88). Enable once per clone:
#   git config core.hooksPath .githooks
set -uo pipefail
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = refs/heads/recovery/2026-09-12 ] || continue
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] &&
    { echo "pre-push: refusing to delete the production branch" >&2; exit 1; }
  bash scripts/ci-local-receipt.sh "$local_sha" ||
    { echo "pre-push: production needs a ci-local PASS receipt; use scripts/deploy-promote.sh" >&2; exit 1; }
done
exit 0
