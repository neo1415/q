{
  "name": "capital-q",
  "private": true,
  "type": "module",
  "description": "Capital Q \u2014 AI-native Investment Intelligence Operating System for private capital.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "turbo run build --filter=@capital-q/web... && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "test:db": "supabase test db",
    "clean": "turbo run clean",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:types": "supabase gen types typescript --local --schema identity,permissions,events,audit > packages/database/src/generated/database.types.ts",
    "db:types:check": "pnpm db:types && git diff --exit-code -- packages/database/src/generated"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "turbo": "^2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
