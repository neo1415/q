{
  "name": "@capital-q/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Capital Q application API \u00e2\u20ac\u201d Fastify composition root.",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc",
